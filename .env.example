# ShopFlow — environment variables. Copy to .env and fill in real values; .env is never committed.
# Generate secrets with: openssl rand -base64 48

# Spring profile: dev (local) or prod
SPRING_PROFILES_ACTIVE=dev

# JWT: at least 32 bytes. The app refuses to start without it.
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Postgres
DB_NAME=shopflow
DB_USER=shopflow_user
DB_PASSWORD=
DB_URL=jdbc:postgresql://localhost:5432/shopflow

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Comma-separated origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:4200

# First admin, created on startup if the email doesn't exist yet. Leave empty to skip.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Email (HU-31, HU-33). Commented out = Mailpit, the local inbox at http://localhost:8025.
# For production uncomment and fill in any SMTP (Brevo, Resend, Gmail with an app password…).
# Don't leave them as "MAIL_PORT=" with nothing: an empty value replaces the default.
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
MAIL_FROM=ShopFlow <no-reply@shopflow.local>

# Sign in with Google (HU-32): OAuth client id ("Web application") from console.cloud.google.com.
# Add the store's URL (http://localhost:4200, http://localhost, https://your-domain) as an authorized
# JavaScript origin. Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# Mercado Pago, Checkout Pro (HU-18). Credentials at mercadopago.com.ar/developers → Tus integraciones → your app.
# Left empty the store still works: "Pagar con Mercado Pago" answers "El pago no está disponible".
# Access token: the test one (sandbox) in dev, the production one in production. Never commit it.
MP_ACCESS_TOKEN=
# Secret signature of the webhook (Tus integraciones → your app → Webhooks → "Clave secreta").
MP_WEBHOOK_SECRET=
# true: opens Mercado Pago's sandbox checkout (pay with a test buyer). Defaults: true in dev, false in prod
# (docker compose runs the prod profile: set MP_SANDBOX=true there while you use test credentials).
MP_SANDBOX=true
# Public URL of the API, where Mercado Pago sends the webhook: <API_PUBLIC_URL>/api/payments/webhook.
# Empty: the preference sends no notification_url and Mercado Pago uses the URL set in its panel.
# With docker compose it's the same as PUBLIC_URL (Nginx proxies /api to the backend).
API_PUBLIC_URL=
#
# Testing the webhook in dev: Mercado Pago can't reach localhost, so open a tunnel.
#   Option A, backend from the IDE (port 8080):
#     ngrok http 8080                                  (or: cloudflared tunnel --url http://localhost:8080)
#     API_PUBLIC_URL=https://<your-tunnel>             e.g. https://abcd-1234.ngrok-free.app
#     With the store on localhost the preference goes without auto_return (Mercado Pago refuses it there):
#     after paying, the buyer comes back with "Volver al sitio" instead of by itself.
#   Option B, whole store with docker compose (port 80), so the return to the store works from any device too:
#     cloudflared tunnel --url http://localhost:80     (or: ngrok http 80)
#     PUBLIC_URL=https://<your-tunnel>  and  API_PUBLIC_URL=https://<your-tunnel>
#   Then in Tus integraciones → your app → Webhooks → "Modo de prueba": URL https://<your-tunnel>/api/payments/webhook,
#   event "Pagos", save, and copy the secret into MP_WEBHOOK_SECRET. Restart the backend after changing .env.
#   The tunnel's URL changes each time it starts (free plans): update both places when it does.

# ── Docker / production (HU-04) ──
# Port where the store is published by "docker compose up" (http://localhost by default)
HTTP_PORT=80
# Public URL of the store; also used as the allowed CORS origin in Docker
PUBLIC_URL=http://localhost
# Domain for HTTPS with docker-compose.prod.yml (e.g. tienda.com.ar)
DOMAIN=
